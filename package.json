{
  "name": "insighthub",
  "version": "0.0.0",
  "private": true,
  "description": "InsightHub - team knowledge base document & AI assistant platform (M0 bootstrap)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "pnpm --filter @insighthub/shared build",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @insighthub/web dev",
    "dev:server": "pnpm --filter @insighthub/server dev",
    "build": "pnpm --filter @insighthub/shared build && pnpm --filter @insighthub/server build && pnpm --filter @insighthub/web build",
    "start": "pnpm --filter @insighthub/server start",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter @insighthub/shared build",
    "test": "vitest run && pnpm --filter @insighthub/server test",
    "test:unit": "vitest run",
    "pretest:unit": "pnpm --filter @insighthub/shared build",
    "test:server": "pnpm --filter @insighthub/server test",
    "test:watch": "vitest",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,css,html}\" \"*.{json,yaml,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,json,css,html}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
